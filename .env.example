# Environment example for TrámiteYa

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next / Node
NODE_ENV=development
PORT=3000

# Wompi — public key may be exposed to the browser; secrets must remain server-side
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# SIMIT / Verifik — server-side only; NEVER use NEXT_PUBLIC_ for these secrets
SIMIT_PROVIDER=verifik
VERIFIK_TOKEN=
# VERIFIK_API_TOKEN=  # accepted as an alternative name

# Wompi webhook endpoint in production:
# https://<your-domain>/api/webhooks/wompi
