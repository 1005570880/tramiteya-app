# Environment example for TrámiteYa

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next / Node
NODE_ENV=development
PORT=3000

# OpenAI — server-side only; never expose the API key with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Wompi — public key may be exposed to the browser; secrets must remain server-side
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Wompi webhook endpoint in production:
# https://<your-domain>/api/webhooks/wompi
