# Environment example for TrámiteYa

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next / Node
NODE_ENV=development
PORT=3000

# Legal AI — server-side only; never use NEXT_PUBLIC_ for the API key
OPENAI_API_KEY=
OPENAI_MODEL=

# SIMIT data provider — server-side only
# verifik | placapi | coresoft
SIMIT_PROVIDER=verifik
VERIFIK_API_TOKEN=
PLACAPI_API_KEY=
CORESOFT_API_KEY=

# Wompi — public key may be exposed to the browser; secrets must remain server-side
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Wompi webhook endpoint in production:
# https://<your-domain>/api/webhooks/wompi
